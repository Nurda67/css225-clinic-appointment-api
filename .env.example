DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic_db
DB_USER=clinic_app
DB_PASSWORD=replace_with_your_local_password

# DATABASE_URL can override the individual DB_* values.
# Optional Windows fallback using installed PostgreSQL client libraries.
# PSYCOPG_IMPL=python
# POSTGRES_BIN=C:/Program Files/PostgreSQL/18/bin
# DISABLE_SQLALCHEMY_CEXT_RUNTIME=1

# Generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# The demo seed prompts for a password. Scripts may supply DEMO_PASSWORD in their environment.
